  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Rate versus capacity",
      "description": "Goodput received per 10 ms interval against the trace capacity.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "interval": "100ms",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "avg_over_time({app=\"budgetcc\", kind=\"sample\", trace=~\"$trace\", buffer=~\"$buffer\", phase=~\"$phase\", mode=~\"$mode\", budget=~\"$budget\"} | json | unwrap rate_mbps | __error__=\"\" [$__interval]) by (algo)",
          "refId": "A",
          "legendFormat": "{{algo}}",
          "queryType": "range"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "max(max_over_time({app=\"budgetcc\", kind=\"sample\", trace=~\"$trace\", buffer=~\"$buffer\", phase=~\"$phase\", mode=~\"$mode\", budget=~\"$budget\"} | json | unwrap cap_mbps | __error__=\"\" [$__interval]))",
          "refId": "B",
          "legendFormat": "capacity",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Mbits",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "capacity"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    6
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "dark-gray"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Queue delay with budget line",
      "description": "Ground-truth queue delay at the bottleneck. The red dashed line is the budget D.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "interval": "100ms",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "max_over_time({app=\"budgetcc\", kind=\"sample\", trace=~\"$trace\", buffer=~\"$buffer\", phase=~\"$phase\", mode=~\"$mode\", budget=~\"$budget\"} | json | unwrap q_ms | __error__=\"\" [$__interval]) by (algo)",
          "refId": "A",
          "legendFormat": "{{algo}}",
          "queryType": "range"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "vector($budget_line)",
          "refId": "B",
          "legendFormat": "budget D",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "dashed"
